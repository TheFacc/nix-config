# Example plaintext structure. Copy to secrets.yaml and encrypt with sops.
# Do NOT commit this file with real values; only commit encrypted secrets.yaml.
#
# sops-nix resolves secret names with slashes as NESTED keys, e.g.
#   services/syncthing/gui_password  ->  services: syncthing: gui_password:
# A single YAML key literally named "services/syncthing/gui_password" will NOT work.
#
#   cp secrets.yaml.example secrets.yaml
#   sops secrets.yaml
#
users:
  facc:
    git:
      email: you@example.com
      work_email: you@work.example
services:
  syncthing:
    gui_password: your-syncthing-gui-password-plaintext
  n8n:
    port: "5678"
  servermon:
    # Telegram bot for server alerts (hosts/common/optional/services/servermon.nix)
    # token: talk to @BotFather -> /newbot
    bot_token: "123456789:AAExampleExampleExampleExample"
    # chat id: send any message to the bot, then open
    #   https://api.telegram.org/bot<token>/getUpdates  -> result[].message.chat.id
    chat_id: "123456789"
hosts:
  nixex:
    tailscale:
      tailnet: your-tailnet-name
